# KaamAsaan Engineer Portal — environment template
# Copy to .env and fill in. Never commit a real .env.
# Only public values belong here: the service-role key must never be used in
# frontend code, and must never appear in this file.

# Use the SAME Supabase project as the KaamAsaan mobile app / admin dashboard.
# (Both of those repos already carry these two values under the same names.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true  -> portal runs entirely on local mock data (isolated UI development)
# false -> real Supabase survey lookup, the production target
#
# In real mode a Supabase Auth session is REQUIRED: public.survey_bookings has
# every privilege revoked for `anon`, and its select policy is
# `user_id = auth.uid() OR private.is_admin()`. Real mode never falls back to
# mock data.
VITE_USE_MOCK_DATA=false
